# AI provider: groq | local
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Local fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LOCAL_WHISPER_MODEL=large-v3
LOCAL_WHISPER_DEVICE=cpu

# Discovery (optional)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Storage & queue
DATABASE_URL=postgresql+psycopg://clipforge:clipforge@db:5432/clipforge
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage

# Media binaries (absolute paths if not on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Media defaults (see QUALITY.md)
DEFAULT_QUALITY_MODE=visually_lossless
DEFAULT_RATIO=9:16
RENDER_HEIGHT=1080
CRF_FINAL=17
CRF_DRAFT=20
CRF_BALANCED=21
OUTPUT_FPS=30
LOUDNESS_TARGET=-14

# Server
API_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
